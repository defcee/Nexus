# Nexus Global Parcel Services - Apache Configuration

# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Remove trailing slash (except for directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]
  
  # Proxy requests to Node.js
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://localhost:8080/$1 [P,L]
</IfModule>

# Enable mod_proxy
<IfModule mod_proxy.c>
  ProxyPreserveHost On
  
  # Don't proxy static files
  ProxyPass /dist/ !
  ProxyPass /public/ !
  ProxyPass /assets/ !
  
  # Proxy to Node.js
  ProxyPass / http://localhost:8080/
  ProxyPassReverse / http://localhost:8080/
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml+rss
</IfModule>

# Caching headers for static assets
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "max-age=31536000, public"
  </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Enable XSS protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Force HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory listing
<FilesMatch "^$">
  Order allow,deny
  Deny from all
</FilesMatch>

Options -Indexes

# Block access to sensitive files
<FilesMatch "^(\.env|\.git|package\.json|ecosystem\.config\.js)">
  Order allow,deny
  Deny from all
</FilesMatch>

# 404 Error Page
ErrorDocument 404 /index.html

# Gzip compression
<IfModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_dechunk Yes
  mod_gzip_item_include file \.(html?|txt|css|js|json|xml|rss|svg)$
  mod_gzip_item_include handler ^cgi-script$
  mod_gzip_item_exclude mime ^image/
  mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip
  mod_gzip_minimum_file_size 500
</IfModule>
