# Environment variables example for Nexus project

# MySQL connection (cPanel provides these values)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# Optional: override or fallback
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# App
PORT=3000
PING_MESSAGE=ping

# Admin basic auth (optional, recommended)
# If BASIC_AUTH_USER and BASIC_AUTH_PASSWORD are set, the server will require HTTP Basic Auth for /admin.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=admin123

# Admin credentials (legacy fallback used by admin login endpoint)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
